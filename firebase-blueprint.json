{
  "entities": {
    "DeveloperProfile": {
      "title": "DeveloperProfile",
      "description": "Private developer registration and verification profile for an Appzora publisher.",
      "type": "object",
      "properties": {
        "uid": {
          "type": "string",
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "firstName": {
          "type": "string",
          "minLength": 1,
          "maxLength": 60
        },
        "lastName": {
          "type": "string",
          "minLength": 1,
          "maxLength": 60
        },
        "mobile": {
          "type": "string",
          "minLength": 11,
          "maxLength": 11,
          "pattern": "^01[3-9][0-9]{8}$"
        },
        "email": {
          "type": "string",
          "minLength": 5,
          "maxLength": 150,
          "pattern": "^[^\\s@]+@[^\\s@]+\\.[^\\s@]+$"
        },
        "passwordHash": {
          "type": "string",
          "minLength": 32,
          "maxLength": 128
        },
        "agreedToTerms": {
          "type": "boolean"
        },
        "status": {
          "type": "string",
          "enum": ["pending_verification", "verified"]
        },
        "verificationToken": {
          "type": "string",
          "minLength": 8,
          "maxLength": 64,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "studioName": {
          "type": "string",
          "minLength": 1,
          "maxLength": 80
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": [
        "uid",
        "firstName",
        "lastName",
        "mobile",
        "email",
        "passwordHash",
        "agreedToTerms",
        "status",
        "verificationToken",
        "studioName",
        "createdAt",
        "updatedAt"
      ]
    },
    "StoreApp": {
      "title": "StoreApp",
      "description": "Published application or game listing in the Appzora catalog.",
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "ownerId": {
          "type": "string",
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "title": {
          "type": "string",
          "minLength": 2,
          "maxLength": 80
        },
        "titleLower": {
          "type": "string",
          "minLength": 2,
          "maxLength": 80
        },
        "packageName": {
          "type": "string",
          "minLength": 3,
          "maxLength": 100,
          "pattern": "^[a-zA-Z0-9_.]+$"
        },
        "developerName": {
          "type": "string",
          "minLength": 2,
          "maxLength": 80
        },
        "appType": {
          "type": "string",
          "enum": ["Games", "Apps"]
        },
        "category": {
          "type": "string",
          "minLength": 2,
          "maxLength": 40
        },
        "shortDescription": {
          "type": "string",
          "minLength": 5,
          "maxLength": 160
        },
        "description": {
          "type": "string",
          "minLength": 10,
          "maxLength": 2500
        },
        "whatsNew": {
          "type": "string",
          "maxLength": 500
        },
        "version": {
          "type": "string",
          "minLength": 1,
          "maxLength": 24
        },
        "sizeLabel": {
          "type": "string",
          "minLength": 2,
          "maxLength": 24
        },
        "ageRating": {
          "type": "string",
          "enum": ["3+", "7+", "12+", "16+", "18+"]
        },
        "iconUrl": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200000
        },
        "bannerUrl": {
          "type": "string",
          "maxLength": 250000
        },
        "screenshots": {
          "type": "array",
          "description": "Up to 4 HD screenshot URLs or compressed data URIs."
        },
        "downloadUrl": {
          "type": "string",
          "maxLength": 500
        },
        "apkFileName": {
          "type": "string",
          "maxLength": 120
        },
        "rating": {
          "type": "number"
        },
        "ratingCount": {
          "type": "number"
        },
        "installCount": {
          "type": "number"
        },
        "status": {
          "type": "string",
          "enum": ["published", "draft"]
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": [
        "id",
        "ownerId",
        "title",
        "titleLower",
        "packageName",
        "developerName",
        "appType",
        "category",
        "shortDescription",
        "description",
        "whatsNew",
        "version",
        "sizeLabel",
        "ageRating",
        "iconUrl",
        "bannerUrl",
        "screenshots",
        "downloadUrl",
        "apkFileName",
        "rating",
        "ratingCount",
        "installCount",
        "status",
        "createdAt",
        "updatedAt"
      ]
    },
    "AppReview": {
      "title": "AppReview",
      "description": "User rating and written review for an app in the store.",
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "appId": {
          "type": "string",
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "authorId": {
          "type": "string",
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "authorName": {
          "type": "string",
          "minLength": 1,
          "maxLength": 80
        },
        "authorPhoto": {
          "type": "string",
          "maxLength": 500
        },
        "rating": {
          "type": "number"
        },
        "comment": {
          "type": "string",
          "minLength": 2,
          "maxLength": 600
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": [
        "id",
        "appId",
        "authorId",
        "authorName",
        "authorPhoto",
        "rating",
        "comment",
        "createdAt"
      ]
    },
    "UserLibraryItem": {
      "title": "UserLibraryItem",
      "description": "Private per-user installation and wishlist record for an app.",
      "type": "object",
      "properties": {
        "appId": {
          "type": "string",
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "userId": {
          "type": "string",
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "installed": {
          "type": "boolean"
        },
        "wishlisted": {
          "type": "boolean"
        },
        "installedVersion": {
          "type": "string",
          "maxLength": 24
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": [
        "appId",
        "userId",
        "installed",
        "wishlisted",
        "installedVersion",
        "updatedAt"
      ]
    }
  },
  "firestore": {
    "/developers/{developerId}": {
      "schema": {
        "$ref": "#/entities/DeveloperProfile"
      },
      "description": "Owner-isolated developer registration and verification records."
    },
    "/apps/{appId}": {
      "schema": {
        "$ref": "#/entities/StoreApp"
      },
      "description": "Public Appzora store applications and games."
    },
    "/apps/{appId}/reviews/{reviewId}": {
      "schema": {
        "$ref": "#/entities/AppReview"
      },
      "description": "User reviews nested under each store app."
    },
    "/users/{userId}/library/{appId}": {
      "schema": {
        "$ref": "#/entities/UserLibraryItem"
      },
      "description": "Private installed apps and wishlist items for each user."
    }
  }
}
